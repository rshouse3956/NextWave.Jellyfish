<?xml version="1.0" encoding="utf-8"?>
<RunSettings>
  <DataCollectionRunSettings>
    <DataCollectors>
      <DataCollector friendlyName="XPlat Code Coverage">
        <Configuration>
          <!-- Output coverage in Cobertura XML format under TestResults -->
          <Format>cobertura</Format>
          <SkipAutoProps>true</SkipAutoProps>
          <!-- Include only product assemblies -->
          <Include>[JellyFish.Api]*</Include>
          <!-- Common excludes -->
          <Exclude>[xunit.*]*
                   [Moq]*
                   [FluentAssertions]*</Exclude>
          <ExcludeByFile>**/Migrations/*.cs</ExcludeByFile>
        </Configuration>
      </DataCollector>
    </DataCollectors>
  </DataCollectionRunSettings>
</RunSettings>

