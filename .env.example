# Copy to .env beside the compose file and fill in. .env is not tracked in git.

# --- Image ---------------------------------------------------------------------------------------------------------
# Used by docker-compose.truenas.yml. Published by CI to GHCR.
JELLYFISH_IMAGE=ghcr.io/rshouse3956/jellyfish
# Pin a version (e.g. sha-<commit> or X.Y.Z) for repeatable deploys; "latest" follows main.
JELLYFISH_TAG=latest

# --- MongoDB -------------------------------------------------------------------------------------------------------
MONGO_USER=root
MONGO_PASS=change-me
DB_NAME=jellyfish

# Login for the mongo-express web UI (port 8086)
ME_USER=admin
ME_PASS=change-me-too

# --- Controller ----------------------------------------------------------------------------------------------------
# Controller websocket URI (required)
CONTROLLER_WS_URI=ws://controller-host:9000/ws

# --- Schedule location ---------------------------------------------------------------------------------------------
# Where the lights are, for sunrise/sunset schedules: decimal degrees (latitude required, longitude required) and
# elevation in metres (optional, default 0). Kept out of the repo.
SCHEDULE_LATITUDE=0.0
SCHEDULE_LONGITUDE=0.0
SCHEDULE_ELEVATION_METERS=0

# --- Pattern assistant (optional) ----------------------------------------------------------------------------------
# AI pattern generation via Ollama. Off unless true. The model must be pulled on the Ollama server first
# (ollama pull <model>); GET /api/pattern-assistant/status reports whether it is ready.
PATTERN_ASSISTANT_ENABLED=false
# The compose ollama service, or Ollama on another machine, e.g. http://192.168.1.50:11434
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=qwen2.5:7b
